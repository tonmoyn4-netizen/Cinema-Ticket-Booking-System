@model CinemaTicketBookingSystem.Models.Showtime
@{ ViewBag.Title = "Add Showtime"; }
<h2>Add Showtime</h2>
@using(Html.BeginForm()){
 @Html.AntiForgeryToken() 
 @Html.ValidationSummary(true,"Please fix the errors.",new{@class="text-danger"})
 <div class="form-group">@Html.LabelFor(m=>m.MovieId,"Movie") @Html.DropDownListFor(m=>m.MovieId,(SelectList)ViewBag.MovieList,"-- Select Movie --",new{@class="form-control"}) @Html.ValidationMessageFor(m=>m.MovieId,"",new{@class="text-danger"})</div>
 <div class="form-group">@Html.LabelFor(m=>m.StartTime) @Html.TextBoxFor(m=>m.StartTime,"{0:yyyy-MM-ddTHH:mm}",new{@class="form-control",type="datetime-local"})</div>
 <div class="row"><div class="col-md-6"><div class="form-group">@Html.LabelFor(m=>m.TicketPrice) @Html.TextBoxFor(m=>m.TicketPrice,new{@class="form-control",type="number",step="0.01"})</div></div><div class="col-md-6"><div class="form-group">@Html.LabelFor(m=>m.TotalSeats) @Html.TextBoxFor(m=>m.TotalSeats,new{@class="form-control",type="number"})</div></div></div>
 <div class="checkbox">@Html.CheckBoxFor(m=>m.IsActive) <label>Active</label></div>
 <button class="btn btn-primary" type="submit">Save</button> <a class="btn btn-default" href="@Url.Action("Index")">Cancel</a>
}
