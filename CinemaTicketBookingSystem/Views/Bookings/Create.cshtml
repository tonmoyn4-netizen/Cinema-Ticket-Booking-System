@model CinemaTicketBookingSystem.Models.BookingVM
@{ ViewBag.Title = "Book Ticket"; }
<h2>Book Cinema Ticket</h2>
<div class="panel panel-primary"><div class="panel-heading">Booking Information</div><div class="panel-body">
@using(Html.BeginForm()){ @Html.AntiForgeryToken()
 @Html.ValidationSummary(true,"Please fix the errors.",new{@class="text-danger"})
 <div class="form-group">@Html.LabelFor(m=>m.ShowtimeId,"Showtime") @Html.DropDownListFor(m=>m.ShowtimeId,Model.ShowtimeList,"-- Select Showtime --",new{@class="form-control"}) @Html.ValidationMessageFor(m=>m.ShowtimeId,"",new{@class="text-danger"})</div>
 <div class="form-group">@Html.LabelFor(m=>m.CustomerId,"Customer") @Html.DropDownListFor(m=>m.CustomerId,Model.CustomerList,"-- Select Customer --",new{@class="form-control"}) @Html.ValidationMessageFor(m=>m.CustomerId,"",new{@class="text-danger"})</div>
 <div class="form-group">@Html.LabelFor(m=>m.SeatCount,"Number of Seats") @Html.TextBoxFor(m=>m.SeatCount,new{@class="form-control",type="number",min="1",max="20"}) @Html.ValidationMessageFor(m=>m.SeatCount,"",new{@class="text-danger"})</div>
 <button type="submit" class="btn btn-primary">Confirm Booking</button> <a class="btn btn-default" href="@Url.Action("Index")">Cancel</a>
}
</div></div>
<p class="text-muted">The system checks available capacity and calculates the total ticket amount automatically.</p>
