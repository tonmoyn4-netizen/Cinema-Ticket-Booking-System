@model CinemaTicketBookingSystem.Models.Movie
@{ ViewBag.Title = "Movie Details"; }
<h2>Movie Details</h2>
<div class="row">
 <div class="col-md-3">@if(!String.IsNullOrEmpty(Model.PosterImage)){<img class="poster-large" src="@Model.PosterImage" />}</div>
 <div class="col-md-9"><table class="table table-bordered">
 <tr><th>Title</th><td>@Model.Title</td></tr><tr><th>Genre</th><td>@Model.Genre</td></tr>
 <tr><th>Duration</th><td>@Model.DurationMinutes minutes</td></tr><tr><th>Release Date</th><td>@Model.ReleaseDate.ToString("dd MMM yyyy")</td></tr>
 <tr><th>Rating</th><td>@Model.Rating</td></tr><tr><th>Active</th><td>@(Model.IsActive?"Yes":"No")</td></tr></table></div>
</div>
<h4>Showtimes</h4>
<table class="table table-bordered"><thead><tr><th>Date & Time</th><th>Ticket Price</th><th>Seats</th><th>Action</th></tr></thead><tbody>
@foreach(var s in Model.Showtimes.OrderBy(x=>x.StartTime)){<tr><td>@s.StartTime.ToString("dd MMM yyyy hh:mm tt")</td><td>৳ @s.TicketPrice.ToString("N0")</td><td>@s.TotalSeats</td><td><a class="btn btn-primary btn-sm" href="@Url.Action("Create","Bookings",new{showtimeId=s.Id})">Book</a></td></tr>}
</tbody></table>
<a class="btn btn-warning" href="@Url.Action("Edit",new{id=Model.Id})">Edit</a> <a class="btn btn-default" href="@Url.Action("Index")">Back</a>
