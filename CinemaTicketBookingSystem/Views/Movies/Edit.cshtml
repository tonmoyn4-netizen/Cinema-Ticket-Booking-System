@model CinemaTicketBookingSystem.Models.Movie
@{ ViewBag.Title = "Edit Movie"; }
<h2>Update Movie</h2>
@using(Html.BeginForm("Edit","Movies",FormMethod.Post,new{enctype="multipart/form-data"})){
 @Html.AntiForgeryToken() @Html.HiddenFor(m=>m.Id) @Html.HiddenFor(m=>m.PosterImage)
 @Html.ValidationSummary(true,"Please fix the errors.",new{@class="text-danger"})
 <div class="form-group">@Html.LabelFor(m=>m.Title) @Html.TextBoxFor(m=>m.Title,new{@class="form-control"}) @Html.ValidationMessageFor(m=>m.Title,"",new{@class="text-danger"})</div>
 <div class="row"><div class="col-md-6"><div class="form-group">@Html.LabelFor(m=>m.Genre) @Html.TextBoxFor(m=>m.Genre,new{@class="form-control"})</div></div>
 <div class="col-md-3"><div class="form-group">@Html.LabelFor(m=>m.DurationMinutes) @Html.TextBoxFor(m=>m.DurationMinutes,new{@class="form-control",type="number"})</div></div>
 <div class="col-md-3"><div class="form-group">@Html.LabelFor(m=>m.Rating) @Html.TextBoxFor(m=>m.Rating,new{@class="form-control"})</div></div></div>
 <div class="form-group">@Html.LabelFor(m=>m.ReleaseDate) @Html.TextBoxFor(m=>m.ReleaseDate,"{0:yyyy-MM-dd}",new{@class="form-control",type="date"})</div>
 if(!String.IsNullOrEmpty(Model.PosterImage)){<img class="poster-preview" src="@Model.PosterImage" />}
 <div class="form-group"><label>Replace Poster</label><input type="file" name="Poster" class="form-control" accept="image/*" /></div>
 <div class="checkbox">@Html.CheckBoxFor(m=>m.IsActive) <label>Active</label></div>
 <button class="btn btn-primary" type="submit">Update</button> <a class="btn btn-default" href="@Url.Action("Index")">Cancel</a>
}
